<?xml version="1.0" encoding="utf-8"?>
<!--
  本项目零第三方依赖（不引用任何 NuGet 包），所有引用都来自 .NET SDK 自带的 packs。
  这里清空包源，让 restore 完全离线进行：
    · 没网 / 公司代理拦 nuget.org 时也能正常还原与发布；
    · 避免 restore 因为"要更新服务索引"而卡住或报 NU1301。
  如果以后真的要引入 NuGet 包，把上面的 <clear /> 去掉或补一个 <add key="nuget.org" value="https://api.nuget.org/v3/index.json" /> 即可。
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>

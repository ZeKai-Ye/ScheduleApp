<Project Sdk="Microsoft.NET.Sdk">

  <!--
    内置零依赖测试运行器（离线环境无法获取 xunit/nunit）。
    直接 dotnet run 即可执行，退出码 0 = 全部通过。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Schedule.Core.Tests</RootNamespace>
    <AssemblyName>Schedule.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Schedule.Core\Schedule.Core.csproj" />
  </ItemGroup>

</Project>

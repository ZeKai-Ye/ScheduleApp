# 统一换行符与二进制识别
* text=auto

*.cs         text eol=crlf
*.csproj     text eol=crlf
*.xaml       text eol=crlf
*.sln        text eol=crlf
*.ps1        text eol=crlf
*.manifest   text eol=crlf
*.json       text eol=lf
*.md         text eol=lf

# 二进制资源，禁止换行符转换
*.ico        binary
*.png        binary
*.exe        binary
*.dll        binary

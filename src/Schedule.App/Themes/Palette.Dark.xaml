<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 夜间主题调色板：只放调色板，切换主题时整块替换这个字典即可 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF15151A" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FF1E1E24" />
    <SolidColorBrush x:Key="Brush.CellMuted" Color="#FF1A1A20" />
    <SolidColorBrush x:Key="Brush.WeekendColumn" Color="#FF191920" />
    <SolidColorBrush x:Key="Brush.Hint" Color="#FF23232A" />
    <SolidColorBrush x:Key="Brush.HintBorder" Color="#FF2E2E37" />
    <SolidColorBrush x:Key="Brush.ScopeBackground" Color="#FF1B2A45" />
    <SolidColorBrush x:Key="Brush.ScopeBorder" Color="#FF2F4B7C" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF30303A" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFE9E9EE" />
    <SolidColorBrush x:Key="Brush.Subtle" Color="#FFA0A0AC" />
    <SolidColorBrush x:Key="Brush.SubtleSoft" Color="#FF6E6E7A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF5B8DEF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF7BA5F5" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FF22375E" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF87171" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FF3A1D1D" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#FF7F1D1D" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#FF23232B" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#FF1F3047" />
    <SolidColorBrush x:Key="Brush.SwatchRing" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="#FF26262E" />

</ResourceDictionary>

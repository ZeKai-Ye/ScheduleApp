<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      夜间主题调色板：只放调色板，切换主题时整块替换这个字典即可。
      键必须与 Palette.Light.xaml 完全一致（Theme.xaml 里全部用 DynamicResource 引用）。
      层级关系：Background（最底）→ Card（卡片）→ Input（输入框，比卡片更暗以形成凹陷感）。
    -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF101216" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FF1B1E25" />
    <SolidColorBrush x:Key="Brush.CellMuted" Color="#FF171A20" />
    <SolidColorBrush x:Key="Brush.WeekendColumn" Color="#FF191C22" />
    <SolidColorBrush x:Key="Brush.Hint" Color="#FF22262E" />
    <SolidColorBrush x:Key="Brush.HintBorder" Color="#FF323743" />
    <SolidColorBrush x:Key="Brush.ScopeBackground" Color="#FF17253C" />
    <SolidColorBrush x:Key="Brush.ScopeBorder" Color="#FF33507F" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF2A2F38" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#FF2E333D" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFE7E9EF" />
    <SolidColorBrush x:Key="Brush.Subtle" Color="#FFA6ADBB" />
    <SolidColorBrush x:Key="Brush.SubtleSoft" Color="#FF848C9B" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF5B8DEF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF7BA5F5" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FF20304F" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF87171" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FF31191C" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#FF7F2A2E" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#FF23272F" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#FF1E2B44" />
    <SolidColorBrush x:Key="Brush.SwatchRing" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="#FF1E222A" />

    <!-- 输入控件：比卡片更暗，边框稍亮，避免"夜间里一片白框" -->
    <SolidColorBrush x:Key="Brush.Input" Color="#FF14161B" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#FF363B47" />

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="#FF171A20" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FF3B414D" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#FF545B69" />

    <!-- 右键菜单 / 提示气泡 -->
    <SolidColorBrush x:Key="Brush.MenuBackground" Color="#FF1E222A" />
    <SolidColorBrush x:Key="Brush.MenuBorder" Color="#FF363B47" />
    <SolidColorBrush x:Key="Brush.MenuHighlight" Color="#FF2C3444" />
    <SolidColorBrush x:Key="Brush.TooltipBackground" Color="#FF2A2F3A" />
    <SolidColorBrush x:Key="Brush.TooltipText" Color="#FFF1F3F8" />

    <!-- 滑块 -->
    <SolidColorBrush x:Key="Brush.SliderTrack" Color="#FF363B47" />

</ResourceDictionary>

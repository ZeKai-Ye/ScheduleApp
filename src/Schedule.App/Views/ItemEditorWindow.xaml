<Window x:Class="Schedule.App.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建日程"
        Width="640" Height="740"
        MinWidth="580" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,18,20,12">
            <StackPanel>
                <TextBlock Text="标题" Style="{StaticResource SectionTitle}" />
                <TextBox x:Name="TitleBox" FontSize="14" Padding="8,8" />

                <TextBlock Text="时间" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="开始" VerticalAlignment="Center" Foreground="{StaticResource Brush.Subtle}" />
                    <Grid Grid.Column="1" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="StartDatePicker" />
                        <TextBox x:Name="StartTimeBox" Grid.Column="1" Margin="6,0,0,0" Text="09:00" ToolTip="24 小时制，例如 09:30" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="结束" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.Subtle}" />
                    <Grid Grid.Column="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="EndDatePicker" />
                        <TextBox x:Name="EndTimeBox" Grid.Column="1" Margin="6,0,0,0" ToolTip="留空表示不指定结束时间" />
                    </Grid>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="AllDayCheck" Content="全天" Click="AllDayCheck_Click" />
                    <CheckBox x:Name="RepeatUntilCheck" Content="重复截止" Margin="18,0,0,0" Click="RepeatUntilCheck_Click" />
                    <DatePicker x:Name="RepeatUntilPicker" Width="150" Margin="8,0,0,0" IsEnabled="False" />
                </StackPanel>

                <TextBlock Text="分类与优先级" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <ComboBox x:Name="CategoryBox" IsEditable="True" ToolTip="可直接输入新的分类名称" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <ComboBox x:Name="PriorityBox" SelectedIndex="1">
                            <ComboBoxItem Content="高优先级" />
                            <ComboBoxItem Content="普通" />
                            <ComboBoxItem Content="低优先级" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <ComboBox x:Name="RepeatBox" SelectedIndex="0">
                            <ComboBoxItem Content="不重复" />
                            <ComboBoxItem Content="每天" />
                            <ComboBoxItem Content="工作日" />
                            <ComboBoxItem Content="每周" />
                            <ComboBoxItem Content="每月" />
                            <ComboBoxItem Content="每年" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="提醒方式" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <TextBox x:Name="RemindBox" ToolTip="15（提前 15 分钟）/ 1小时 / 2025-06-01 08:00 / 0（准点）/ 留空（不提醒）" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="准点" Tag="0" Style="{StaticResource GhostButton}" Click="QuickRemind_Click" />
                    <Button Content="5 分钟" Tag="5" Style="{StaticResource GhostButton}" Click="QuickRemind_Click" />
                    <Button Content="10 分钟" Tag="10" Style="{StaticResource GhostButton}" Click="QuickRemind_Click" />
                    <Button Content="15 分钟" Tag="15" Style="{StaticResource GhostButton}" Click="QuickRemind_Click" />
                    <Button Content="30 分钟" Tag="30" Style="{StaticResource GhostButton}" Click="QuickRemind_Click" />
                    <Button Content="1 小时" Tag="60" Style="{StaticResource GhostButton}" Click="QuickRemind_Click" />
                    <Button Content="1 天" Tag="1440" Style="{StaticResource GhostButton}" Click="QuickRemind_Click" />
                    <Button Content="不提醒" Tag="none" Style="{StaticResource GhostButton}" Click="QuickRemind_Click" />
                </WrapPanel>
                <TextBlock x:Name="RemindPreviewText" Style="{StaticResource FieldHint}" Margin="2,6,0,0" />

                <TextBlock Text="语音播报内容（留空使用全局模板）" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <TextBox x:Name="VoiceTextBox" AcceptsReturn="True" Height="56" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="可用占位符：{title} {time} {date} {weekday} {category} {notes} {priority} {countdown} {status}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="试听这条播报" Click="PreviewVoice_Click" />
                    <TextBlock x:Name="VoicePreviewText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Subtle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Text="自定义提示音（留空使用全局设置）" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SoundBox" />
                    <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0" Click="BrowseSound_Click" />
                    <Button Grid.Column="2" Content="试听" Margin="8,0,0,0" Click="PreviewSound_Click" />
                </Grid>

                <TextBlock Text="备注" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="状态" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <ComboBox x:Name="StatusBox" SelectedIndex="0" Width="200" HorizontalAlignment="Left">
                    <ComboBoxItem Content="待办" />
                    <ComboBoxItem Content="已完成" />
                    <ComboBoxItem Content="已取消" />
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,8,0" />
                    <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" />
                </StackPanel>
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource Brush.Danger}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="Schedule.App.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建日程"
        Width="700" Height="820"
        MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,18,20,12">
            <StackPanel>
                <Border x:Name="ScopePanel" Visibility="Collapsed" Margin="0,0,0,14"
                        Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="这是系列事件中的一次发生，请选择修改范围" FontSize="12" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton x:Name="ScopeSingleRadio" GroupName="EditScope" Content="仅这一次（不影响其它）"
                                         IsChecked="True" Click="Scope_Changed" />
                            <RadioButton x:Name="ScopeSeriesRadio" GroupName="EditScope" Content="整个系列"
                                         Margin="18,0,0,0" Click="Scope_Changed" />
                        </StackPanel>
                        <TextBlock x:Name="ScopeHintText" Style="{StaticResource FieldHint}" Margin="0,6,0,0" />
                        <TextBlock x:Name="OccurrenceStateText" Style="{StaticResource FieldHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="标题" Style="{StaticResource SectionTitle}" />
                <TextBox x:Name="TitleBox" FontSize="14" Padding="8,8" />

                <!-- ============ 时间 ============ -->
                <TextBlock Text="时间" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="开始" VerticalAlignment="Center" Foreground="{StaticResource Brush.Subtle}" />
                    <Grid Grid.Column="1" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="StartDatePicker" />
                        <TextBox x:Name="StartTimeBox" Grid.Column="1" Margin="6,0,0,0" Text="09:00" ToolTip="24 小时制，例如 09:30" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="结束" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.Subtle}" />
                    <Grid Grid.Column="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="EndDatePicker" />
                        <TextBox x:Name="EndTimeBox" Grid.Column="1" Margin="6,0,0,0" ToolTip="留空表示不指定结束时间" />
                    </Grid>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="AllDayCheck" Content="全天" Click="AllDayCheck_Click" />
                </StackPanel>

                <!-- ============ 分类 / 优先级 / 状态 ============ -->
                <TextBlock Text="分类与优先级" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <ComboBox x:Name="CategoryBox" IsEditable="True" ToolTip="可直接输入新的分类名称" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <ComboBox x:Name="PriorityBox" SelectedIndex="1">
                            <ComboBoxItem Content="高优先级" />
                            <ComboBoxItem Content="普通" />
                            <ComboBoxItem Content="低优先级" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <ComboBox x:Name="StatusBox" SelectedIndex="0">
                            <ComboBoxItem Content="待办" />
                            <ComboBoxItem Content="已完成" />
                            <ComboBoxItem Content="已取消" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- ============ 颜色 ============ -->
                <TextBlock Text="事件颜色（用于日历与列表区分）" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="自定义 #" VerticalAlignment="Center" Foreground="{StaticResource Brush.Subtle}" FontSize="12" />
                        <TextBox x:Name="CustomColorBox" Width="86" Margin="4,0,0,0" ToolTip="例如 2563EB" TextChanged="CustomColorBox_TextChanged" />
                    </StackPanel>
                    <ItemsControl x:Name="ColorList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="48" Margin="0,0,4,0">
                                    <RadioButton GroupName="EventColor" Style="{StaticResource ColorSwatch}"
                                                 HorizontalAlignment="Center" Checked="ColorSwatch_Checked">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Brush}"
                                                BorderBrush="#22000000" BorderThickness="1" />
                                    </RadioButton>
                                    <TextBlock Text="{Binding Name}" FontSize="9" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Brush.Subtle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- ============ 重复 / 周期 ============ -->
                <TextBlock Text="重复与周期" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="重复方式" FontSize="11" Foreground="{StaticResource Brush.Subtle}" Margin="0,0,0,3" />
                        <ComboBox x:Name="RepeatBox" SelectedIndex="0">
                            <ComboBoxItem Content="不重复" />
                            <ComboBoxItem Content="每天" />
                            <ComboBoxItem Content="工作日" />
                            <ComboBoxItem Content="每周" />
                            <ComboBoxItem Content="每月" />
                            <ComboBoxItem Content="每年" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="间隔（每 N 个周期）" FontSize="11" Foreground="{StaticResource Brush.Subtle}" Margin="0,0,0,3" />
                        <TextBox x:Name="IntervalBox" Text="1" ToolTip="例如：每周 + 间隔 2 = 每两周" TextChanged="RepeatText_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="重复次数（留空不限）" FontSize="11" Foreground="{StaticResource Brush.Subtle}" Margin="0,0,0,3" />
                        <TextBox x:Name="CountBox" ToolTip="例如 10 表示共重复 10 次" TextChanged="RepeatText_Changed" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="WeekdayPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="每周的哪几天（不选则与开始时间同一星期）" FontSize="11" Foreground="{StaticResource Brush.Subtle}" Margin="0,0,0,5" />
                    <ItemsControl x:Name="WeekdayList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource ChipToggle}" Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="RepeatInput_Changed" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="RepeatUntilCheck" Content="重复截止到" Click="RepeatUntilCheck_Click" />
                    <DatePicker x:Name="RepeatUntilPicker" Width="150" Margin="8,0,0,0" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="RepeatSummaryText" Style="{StaticResource FieldHint}" Margin="2,6,0,0" />

                <!-- ============ 提醒 ============ -->
                <TextBlock Text="提醒（可多档：如提前 30 / 15 / 5 分钟各提醒一次）" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <CheckBox x:Name="ReminderEnabledCheck" Content="启用提醒" Click="ReminderInput_Changed" />

                <ItemsControl x:Name="OffsetList" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ChipToggle}" Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="ReminderInput_Changed" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomOffsetsBox" ToolTip="自定义档位（分钟，逗号分隔），例如 90,240" TextChanged="ReminderText_Changed" />
                    <TextBlock Grid.Column="1" Text="自定义档位（分钟）" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontSize="11" Foreground="{StaticResource Brush.Subtle}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="AbsoluteCheck" Content="另外指定一个具体提醒时刻" Click="AbsoluteCheck_Click" />
                    <DatePicker x:Name="AbsoluteDatePicker" Width="140" Margin="8,0,0,0" IsEnabled="False" />
                    <TextBox x:Name="AbsoluteTimeBox" Width="76" Margin="8,0,0,0" IsEnabled="False" TextChanged="ReminderText_Changed" ToolTip="例如 08:00" />
                </StackPanel>

                <TextBlock x:Name="ReminderSummaryText" Style="{StaticResource FieldHint}" Margin="2,8,0,0" />

                <TextBlock Text="按档位自定义播报（可选：不同时间点说不同的话）" Style="{StaticResource SectionTitle}" Margin="2,14,0,6" />
                <ItemsControl x:Name="OffsetDetailList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontSize="12" />
                                    <TextBlock Text="{Binding SourceHint}" FontSize="10" Foreground="{StaticResource Brush.Subtle}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Margin="6,0,0,0"
                                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="该档位专属播报文案，支持全部占位符" />
                                <Button Grid.Column="2" Content="{Binding SoundLabel}" Margin="6,0,0,0"
                                        Click="OffsetSound_Click" ToolTip="{Binding SoundTooltip}" />
                                <Button Grid.Column="3" Content="清" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                        Click="OffsetSoundClear_Click" ToolTip="清除该档位铃声" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="OffsetDetailHint" Style="{StaticResource FieldHint}" />

                <!-- ============ 语音 / 铃声 ============ -->
                <TextBlock Text="语音播报内容（留空使用全局模板）" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <TextBox x:Name="VoiceTextBox" AcceptsReturn="True" Height="52" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="可用占位符：{title} {time} {date} {weekday} {category} {notes} {priority} {countdown} {status} {offset}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="试听这条播报" Click="PreviewVoice_Click" />
                    <TextBlock x:Name="VoicePreviewText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource Brush.Subtle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Text="自定义提示音（留空使用全局设置）" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SoundBox" />
                    <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0" Click="BrowseSound_Click" />
                    <Button Grid.Column="2" Content="试听" Margin="8,0,0,0" Click="PreviewSound_Click" />
                </Grid>

                <TextBlock Text="备注" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RestoreButton" Content="恢复本次默认" Style="{StaticResource GhostButton}"
                            Click="Restore_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,8,0" />
                    <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" />
                </StackPanel>
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource Brush.Danger}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

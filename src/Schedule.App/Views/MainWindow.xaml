<Window x:Class="Schedule.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Schedule.App.Mvvm"
        Title="{l:Text '日程助手|Schedule Assistant'}"
        Height="820" Width="1280" MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}"
>
    <Window.Resources>
        <ContextMenu x:Key="ScheduleItemMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:Text '编辑…|Edit…'}" Tag="edit" Click="ScheduleContext_Action" />
            <MenuItem Header="{l:Text '改期…|Reschedule…'}" Tag="reschedule" Click="ScheduleContext_Action" />
            <Separator />
            <MenuItem Header="{l:Text '删除本次（仅系列）|Delete this occurrence (series only)'}" Tag="delete-once" Click="ScheduleContext_Action" />
            <MenuItem Header="{l:Text '删除整个系列|Delete entire series'}" Tag="delete-series" Click="ScheduleContext_Action" />
            <MenuItem Header="{l:Text '恢复本次默认|Restore this occurrence'}" Tag="restore" Click="ScheduleContext_Action" />
            <Separator />
            <MenuItem Header="{l:Text '标记完成 / 未完成|Mark done / open'}" Tag="toggle" Click="ScheduleContext_Action" />
        </ContextMenu>

        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DayLabel" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Width="190"
                             Margin="0,0,10,0"
                             ToolTip="{l:Text '搜索标题 / 备注 / 分类（Ctrl+F）|Search title / notes / category (Ctrl+F)'}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    <Button Content="{l:Text 'AI 对话|AI chat'}" Click="AiChat_Click" Margin="0,0,8,0" ToolTip="{l:Text '和本地大模型对话，直接让它查 / 改日程（Ctrl+K）|Chat with the local model to look up or change events (Ctrl+K)'}" />
                    <Button Content="{l:Text '新建日程|New event'}" Style="{StaticResource PrimaryButton}" Click="NewItem_Click" Margin="0,0,8,0" ToolTip="Ctrl+N" />
                    <Button Content="{l:Text '导入日程|Import events'}" Click="ImportCsv_Click" Margin="0,0,8,0" ToolTip="{l:Text '支持 CSV（统一格式）与 iCalendar（.ics）；Ctrl+I|Supports CSV (unified format) and iCalendar (.ics); Ctrl+I'}" />
                    <Button Content="{l:Text '导出|Export'}" Click="Export_Click" Margin="0,0,8,0" />
                    <Button Content="{l:Text '设置|Settings'}" Click="Settings_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:Text '日程助手|Schedule Assistant'}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock x:Name="DataDirText"
                               Margin="14,0,0,2"
                               VerticalAlignment="Bottom"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Subtle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,14" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <CheckBox Content="{l:Text '显示已完成日程|Show done events'}"
                                  Margin="2,14,0,0"
                                  IsChecked="{Binding ShowCompleted, Mode=TwoWay}" />
                        <Button Content="{l:Text '清理已完成 / 已取消|Clear done / canceled'}"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Click="ClearCompleted_Click" />
                    </StackPanel>

                    <StackPanel>
                        <StackPanel Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Text '时间范围|Time range'}" Style="{StaticResource SectionTitle}" />
                            <ListBox Style="{StaticResource FilterListBox}"
                                     ItemsSource="{Binding Filters}"
                                     SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                                     DisplayMemberPath="Name" />
                        </StackPanel>

                        <TextBlock Text="{l:Text '分类|Category'}" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <ListBox Style="{StaticResource FilterListBox}"
                                 MaxHeight="300"
                                 ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource FieldHint}"
                                   Margin="2,14,0,0"
                                   Text="{l:Text '提示：周 / 月视图只按分类与搜索过滤；双击空白处可在该时间点新建日程。|Tip: Week / Month views only filter by category and search; double-click empty space to create an event at that time.'}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 视图切换与导航 -->
                <DockPanel Grid.Row="0" Margin="2,0,2,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Brush.Subtle}" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="{l:Text '刷新|Refresh'}" Style="{StaticResource GhostButton}" Click="Refresh_Click" Margin="8,0,0,0" ToolTip="F5" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Card}" Padding="3" CornerRadius="9">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ListModeButton" Style="{StaticResource SegmentButton}" Content="{l:Text '列表|List'}" GroupName="ViewMode" Click="ViewList_Click" />
                                <RadioButton x:Name="WeekModeButton" Style="{StaticResource SegmentButton}" Content="{l:Text '周|Week'}" GroupName="ViewMode" Click="ViewWeek_Click" />
                                <RadioButton x:Name="MonthModeButton" Style="{StaticResource SegmentButton}" Content="{l:Text '月|Month'}" GroupName="ViewMode" Click="ViewMonth_Click" />
                            </StackPanel>
                        </Border>

                        <Button Content="{l:Text '今天|Today'}" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Today_Click" />
                        <Button Content="◀" Style="{StaticResource NavButton}" Margin="6,0,0,0" Click="Prev_Click" IsEnabled="{Binding IsCalendarView}" ToolTip="{l:Text '上一周 / 上一月|Previous week / month'}" />
                        <Button Content="▶" Style="{StaticResource NavButton}" Margin="2,0,0,0" Click="Next_Click" IsEnabled="{Binding IsCalendarView}" ToolTip="{l:Text '下一周 / 下一月|Next week / month'}" />
                        <TextBlock Text="{Binding PeriodLabel}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="14" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <!-- ================= 列表视图 ================= -->
                    <Border Style="{StaticResource Card}" Padding="10,6,14,10"
                            Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <ListView x:Name="ScheduleList"
                                      ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                                      MouseDoubleClick="ScheduleList_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="ScheduleList_PreviewMouseRightButtonDown">
                                <ListView.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{l:Text '编辑…|Edit…'}" Click="EditRow_Click" />
                                        <MenuItem Header="{l:Text '改期…|Reschedule…'}" Click="RescheduleRow_Click" />
                                        <MenuItem Header="{l:Text '标记完成 / 未完成|Mark done / open'}" Click="ToggleDone_Click" />
                                        <Separator />
                                        <MenuItem Header="{l:Text '删除本次（仅系列）|Delete this occurrence (series only)'}" Click="DeleteOccurrenceRow_Click" />
                                        <MenuItem Header="{l:Text '删除整个系列|Delete entire series'}" Click="DeleteRow_Click" />
                                        <MenuItem Header="{l:Text '恢复本次默认|Restore this occurrence'}" Click="RestoreOccurrenceRow_Click" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           Margin="6,16,0,6" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListView.GroupStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="10">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="{Binding ColorBrush}" Height="30" ToolTip="{Binding CategoryText}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="{l:Text '完成|Done'}" Width="52">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center"
                                                              IsChecked="{Binding IsDone, Mode=OneWay}"
                                                              Click="ToggleDone_Click"
                                                              ToolTip="{l:Text '标记完成 / 未完成|Mark done / open'}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="{l:Text '时间|Time'}" Width="150" DisplayMemberBinding="{Binding TimeText}" />

                                        <GridViewColumn Header="{l:Text '日程|Event'}" Width="240">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TitleText}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextDecorations="{Binding IsDone, Converter={StaticResource DoneToDecoration}}" />
                                                        <TextBlock Text="{Binding NotesPreview}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Brush.Subtle}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding NotesPreview, Converter={StaticResource TextToVisibility}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="{l:Text '分类|Category'}" Width="84" DisplayMemberBinding="{Binding CategoryText}" />
                                        <GridViewColumn Header="{l:Text '提醒|Reminder'}" Width="132" DisplayMemberBinding="{Binding ReminderText}" />
                                        <GridViewColumn Header="{l:Text '重复|Repeat'}" Width="112" DisplayMemberBinding="{Binding RepeatText}" />

                                        <GridViewColumn Header="{l:Text '优先级|Priority'}" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PriorityText}"
                                                               Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="{l:Text '操作|Actions'}" Width="104">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="{l:Text '编辑|Edit'}" Style="{StaticResource IconButton}" Click="EditRow_Click" />
                                                        <Button Content="{l:Text '删除|Delete'}" Style="{StaticResource IconButton}"
                                                                Foreground="{DynamicResource Brush.Danger}" Click="DeleteRow_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{l:Text '这个范围内还没有日程|No events in this range'}" FontSize="15" Foreground="{DynamicResource Brush.Subtle}" HorizontalAlignment="Center" />
                                <TextBlock Text="{l:Text '点击右上角「新建日程」，或「导入日程」批量导入（CSV / ICS）|Click New event in the top-right, or import events in bulk (CSV / ICS)'}"
                                           Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Brush.Subtle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ================= 周视图 ================= -->
                    <Border Style="{StaticResource Card}" Padding="0"
                            Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 星期表头 -->
                            <Grid Grid.Row="0" Background="{DynamicResource Brush.Card}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekColumns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,1" Padding="4,8">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding HeaderText}" FontSize="11" HorizontalAlignment="Center"
                                                               Foreground="{Binding HeaderForeground}" />
                                                    <Border Width="24" Height="24" CornerRadius="12" Margin="0,3,0,0"
                                                            Background="{Binding DayNumberBackground}">
                                                        <TextBlock Text="{Binding DayNumberText}" FontSize="13" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{Binding HeaderForeground}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- 全天事件条 -->
                            <Grid Grid.Row="1" MinHeight="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:Text '全天|All day'}" FontSize="10" Foreground="{DynamicResource Brush.Subtle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekColumns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,1" MinHeight="28">
                                                <ItemsControl ItemsSource="{Binding AllDayChips}" Margin="2,3,2,3">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding SoftBrush}" BorderBrush="{Binding ColorBrush}"
                                                                    BorderThickness="3,0,0,0" CornerRadius="3" Padding="4,1" Margin="0,0,2,0"
                                                                    ToolTip="{Binding ToolTipText}"
                                                                    ContextMenu="{StaticResource ScheduleItemMenu}"
                                                                    MouseLeftButtonDown="MonthChip_Click">
                                                                <TextBlock Text="{Binding TitleText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- 时间网格 -->
                            <ScrollViewer Grid.Row="2" x:Name="WeekScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Height="{Binding WeekGridHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding WeekHours}" IsHitTestVisible="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="{Binding Height}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Brush.Subtle}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,8,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Grid.Column="1" x:Name="WeekBody">
                                        <ItemsControl ItemsSource="{Binding WeekHours}" IsHitTestVisible="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding Height}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding WeekColumns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
                                                            Background="{Binding ColumnBackground}">
                                                        <Canvas Background="Transparent" Height="{Binding CanvasHeight}"
                                                                MouseLeftButtonDown="WeekSlot_Click">
                                                            <ItemsControl ItemsSource="{Binding Blocks}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                        <Setter Property="Width" Value="{Binding Width}" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource WeekBlock}" Height="{Binding Height}"
                                                                                ContextMenu="{StaticResource ScheduleItemMenu}"
                                                                                PreviewMouseLeftButtonDown="WeekBlock_DragStart"
                                                                                PreviewMouseMove="WeekBlock_DragMove"
                                                                                PreviewMouseLeftButtonUp="WeekBlock_DragEnd"
                                                                                MouseLeftButtonDown="WeekBlock_Click">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding TitleText}" FontSize="11" FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           TextDecorations="{Binding IsDone, Converter={StaticResource DoneToDecoration}}" />
                                                                                <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                                                           Foreground="{DynamicResource Brush.Subtle}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Canvas>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ================= 月视图 ================= -->
                    <Grid Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10,13,13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MonthSummaryText}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Subtle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PeriodLabel}" FontSize="15" FontWeight="SemiBold" />
                                </DockPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekdayHeaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding MonthCells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="6" Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MonthCell}" MouseLeftButtonDown="MonthCell_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Border Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Left"
                                                                Background="{Binding DayNumberBackground}">
                                                            <TextBlock Text="{Binding DayNumber}" FontSize="11" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{Binding DayNumberForeground}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding MoreText}" FontSize="10" HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                                    </Grid>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Chips}" Margin="0,3,0,0" VerticalAlignment="Top">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding SoftBrush}" BorderBrush="{Binding ColorBrush}"
                                                                        BorderThickness="3,0,0,0" CornerRadius="3" Padding="3,1" Margin="0,1,1,0"
                                                                        ToolTip="{Binding ToolTipText}"
                                                                        ContextMenu="{StaticResource ScheduleItemMenu}"
                                                                        MouseLeftButtonDown="MonthChip_Click">
                                                                    <TextBlock Text="{Binding TitleText}" FontSize="10"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextDecorations="{Binding IsDone, Converter={StaticResource DoneToDecoration}}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- 选中日详情 -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10" MaxHeight="240">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedDayLabel}" Style="{StaticResource SectionTitle}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedDayRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="2,6"
                                                        ContextMenu="{StaticResource ScheduleItemMenu}">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Content="{l:Text '编辑|Edit'}" Style="{StaticResource IconButton}" Click="EditRow_Click" />
                                                            <Button Content="{l:Text '删除|Delete'}" Style="{StaticResource IconButton}"
                                                                    Foreground="{DynamicResource Brush.Danger}" Click="DeleteRow_Click" />
                                                        </StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2" Fill="{Binding ColorBrush}" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Width="120" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Brush.Subtle}" FontSize="12" />
                                                            <TextBlock Grid.Column="2" Text="{Binding TitleText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextDecorations="{Binding IsDone, Converter={StaticResource DoneToDecoration}}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding ReminderText}" Margin="12,0,0,0" FontSize="11"
                                                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                                        </Grid>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding DataDirectoryText}"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.Subtle}"
                           ToolTip="{l:Text '数据目录（可在启动参数中用 --data 修改）|Data folder (change it with --data on the command line)'}" />
                <TextBlock Text="{Binding NextReminderText}" FontSize="12" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

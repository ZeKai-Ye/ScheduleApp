<Window x:Class="Schedule.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日程助手"
        Height="760" Width="1180" MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DayLabel" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Width="190"
                             Margin="0,0,10,0"
                             ToolTip="搜索标题 / 备注 / 分类（Ctrl+F）"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    <Button Content="新建日程" Style="{StaticResource PrimaryButton}" Click="NewItem_Click" Margin="0,0,8,0" ToolTip="Ctrl+N" />
                    <Button Content="导入 CSV" Click="ImportCsv_Click" Margin="0,0,8,0" ToolTip="Ctrl+I" />
                    <Button Content="导出" Click="Export_Click" Margin="0,0,8,0" />
                    <Button Content="设置" Click="Settings_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="日程助手" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" />
                    <TextBlock x:Name="DataDirText"
                               Margin="14,0,0,2"
                               VerticalAlignment="Bottom"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Subtle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,14" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <CheckBox Content="显示已完成日程"
                                  Margin="2,14,0,0"
                                  IsChecked="{Binding ShowCompleted, Mode=TwoWay}" />
                        <Button Content="清理已完成 / 已取消"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Click="ClearCompleted_Click" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="时间范围" Style="{StaticResource SectionTitle}" />
                        <ListBox Style="{StaticResource FilterListBox}"
                                 ItemsSource="{Binding Filters}"
                                 SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                                 DisplayMemberPath="Name" />

                        <TextBlock Text="分类" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <ListBox Style="{StaticResource FilterListBox}"
                                 MaxHeight="260"
                                 ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="2,0,2,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="今天" Style="{StaticResource GhostButton}" Click="Today_Click" />
                        <Button Content="刷新" Style="{StaticResource GhostButton}" Click="Refresh_Click" ToolTip="F5" />
                    </StackPanel>
                    <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Foreground="{StaticResource Brush.Subtle}" FontSize="12" />
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,6,14,10">
                    <Grid>
                        <ListView x:Name="ScheduleList"
                                  ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                                  MouseDoubleClick="ScheduleList_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="ScheduleList_PreviewMouseRightButtonDown">
                            <ListView.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="编辑" Click="EditRow_Click" />
                                    <MenuItem Header="标记完成 / 未完成" Click="ToggleDone_Click" />
                                    <MenuItem Header="删除" Click="DeleteRow_Click" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Accent}"
                                                       Margin="6,16,0,6" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="完成" Width="52">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          IsChecked="{Binding IsDone, Mode=OneWay}"
                                                          Click="ToggleDone_Click"
                                                          ToolTip="标记完成 / 未完成" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding TimeText}" />

                                    <GridViewColumn Header="日程" Width="330">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TitleText}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextDecorations="{Binding IsDone, Converter={StaticResource DoneToDecoration}}" />
                                                    <TextBlock Text="{Binding NotesPreview}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.Subtle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding NotesPreview, Converter={StaticResource TextToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="分类" Width="100" DisplayMemberBinding="{Binding CategoryText}" />
                                    <GridViewColumn Header="提醒" Width="130" DisplayMemberBinding="{Binding ReminderText}" />
                                    <GridViewColumn Header="重复" Width="76" DisplayMemberBinding="{Binding RepeatText}" />

                                    <GridViewColumn Header="优先级" Width="76">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PriorityText}"
                                                           Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="操作" Width="112">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="编辑" Style="{StaticResource IconButton}" Click="EditRow_Click" />
                                                    <Button Content="删除" Style="{StaticResource IconButton}"
                                                            Foreground="{StaticResource Brush.Danger}" Click="DeleteRow_Click" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="这个范围内还没有日程" FontSize="15" Foreground="{StaticResource Brush.Subtle}" HorizontalAlignment="Center" />
                            <TextBlock Text="点击右上角「新建日程」，或「导入 CSV」批量导入"
                                       Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Brush.Subtle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding DataDirectoryText}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.Subtle}"
                           ToolTip="数据目录（可在启动参数中用 --data 修改）" />
                <TextBlock Text="{Binding NextReminderText}" FontSize="12" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

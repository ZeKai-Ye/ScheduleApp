<Window x:Class="Schedule.App.Views.RescheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="改期"
        Width="470" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource Brush.Card}" Padding="20,16">
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="CurrentText" Style="{StaticResource FieldHint}" Margin="0,4,0,0" />

            <TextBlock Text="改到" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <DatePicker x:Name="DateBox" />
                <TextBox x:Name="TimeBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="24 小时制，例如 15:30" />
                <ComboBox x:Name="DurationBox" Grid.Column="2" Margin="8,0,0,0" ToolTip="结束时间 = 新开始时间 + 时长">
                    <ComboBoxItem Content="保持原时长" Tag="keep" />
                    <ComboBoxItem Content="15 分钟" Tag="15" />
                    <ComboBoxItem Content="30 分钟" Tag="30" />
                    <ComboBoxItem Content="45 分钟" Tag="45" />
                    <ComboBoxItem Content="1 小时" Tag="60" />
                    <ComboBoxItem Content="1.5 小时" Tag="90" />
                    <ComboBoxItem Content="2 小时" Tag="120" />
                </ComboBox>
            </Grid>

            <WrapPanel Margin="0,10,0,0">
                <Button Content="今天" Style="{StaticResource GhostButton}" Click="Today_Click" />
                <Button Content="明天" Style="{StaticResource GhostButton}" Click="Tomorrow_Click" />
                <Button Content="+1 天" Style="{StaticResource GhostButton}" Tag="1" Click="ShiftDays_Click" />
                <Button Content="-1 天" Style="{StaticResource GhostButton}" Tag="-1" Click="ShiftDays_Click" />
                <Button Content="+1 周" Style="{StaticResource GhostButton}" Tag="7" Click="ShiftDays_Click" />
                <Button Content="+1 小时" Style="{StaticResource GhostButton}" Tag="60" Click="ShiftMinutes_Click" />
                <Button Content="-1 小时" Style="{StaticResource GhostButton}" Tag="-60" Click="ShiftMinutes_Click" />
            </WrapPanel>

            <StackPanel x:Name="ScopePanel" Margin="0,14,0,0">
                <TextBlock Text="应用范围" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ScopeSingleRadio" GroupName="Scope" Content="仅这一次" IsChecked="True" />
                    <RadioButton x:Name="ScopeSeriesRadio" GroupName="Scope" Content="整个系列（含以后）" Margin="18,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="ScopeHint" Style="{StaticResource FieldHint}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}" FontSize="12"
                       Margin="0,10,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="确定改期" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

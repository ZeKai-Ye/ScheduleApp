<Window x:Class="Schedule.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日程提醒"
        Width="460" SizeToContent="Height"
        MinHeight="240"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="0,4,0,0">
        <StackPanel Margin="22,18,22,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="CategoryText" Text="" FontSize="12" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                <TextBlock Text="日程提醒" FontSize="12" Foreground="{StaticResource Brush.Subtle}" />
            </DockPanel>

            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="TimeText" FontSize="14" Foreground="{StaticResource Brush.Accent}" Margin="0,8,0,0" />
            <TextBlock x:Name="CountdownText" FontSize="12" Foreground="{StaticResource Brush.Subtle}" Margin="0,4,0,0" />

            <TextBlock x:Name="NotesText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" MaxHeight="120" />
            <Border x:Name="VoicePanel" Background="#FFF9FAFB" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                <TextBlock x:Name="VoiceText" FontSize="12" Foreground="{StaticResource Brush.Subtle}" TextWrapping="Wrap" />
            </Border>

            <DockPanel Margin="0,18,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="知道了" Click="Dismiss_Click" Margin="0,0,8,0" />
                    <Button Content="标记完成" Style="{StaticResource PrimaryButton}" Click="Done_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="SnoozeBox" Width="96" SelectedIndex="1">
                        <ComboBoxItem Content="1 分钟" Tag="1" />
                        <ComboBoxItem Content="5 分钟" Tag="5" />
                        <ComboBoxItem Content="10 分钟" Tag="10" />
                        <ComboBoxItem Content="30 分钟" Tag="30" />
                        <ComboBoxItem Content="1 小时" Tag="60" />
                    </ComboBox>
                    <Button Content="稍后提醒" Margin="8,0,0,0" Click="Snooze_Click" />
                    <Button Content="重播语音" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Replay_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

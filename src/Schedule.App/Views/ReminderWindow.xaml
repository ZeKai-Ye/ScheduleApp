<Window x:Class="Schedule.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Schedule.App.Mvvm"
        Title="{l:Text '日程提醒|Reminder'}"
        Width="470" SizeToContent="WidthAndHeight"
        MinHeight="260"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Style="{StaticResource AppWindow}"
>
    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,4,0,0">
        <StackPanel Margin="22,16,22,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="OffsetText" FontSize="12" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Text '日程提醒|Reminder'}" FontSize="12" Foreground="{DynamicResource Brush.Subtle}" />
            </DockPanel>

            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="TimeText" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,8,0,0" />
            <TextBlock x:Name="CountdownText" FontSize="12" Foreground="{DynamicResource Brush.Subtle}" Margin="0,4,0,0" />
            <TextBlock x:Name="PositionHintText" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,2,0,0" />

            <TextBlock x:Name="NotesText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" MaxHeight="120" />

            <Border Background="{DynamicResource Brush.Hint}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="VoiceText" FontSize="12" Foreground="{DynamicResource Brush.Subtle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MoreOffsetsText" FontSize="11" Foreground="{DynamicResource Brush.Warning}"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <DockPanel Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:Text '知道了|Got it'}" Click="Dismiss_Click" Margin="0,0,8,0" />
                    <Button Content="{l:Text '标记完成|Mark done'}" Style="{StaticResource PrimaryButton}" Click="Done_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="SnoozeBox" Width="104" SelectedIndex="1">
                        <ComboBoxItem Content="{l:Text '1 分钟|1 min'}" Tag="1" />
                        <ComboBoxItem Content="{l:Text '5 分钟|5 min'}" Tag="5" />
                        <ComboBoxItem Content="{l:Text '10 分钟|10 min'}" Tag="10" />
                        <ComboBoxItem Content="{l:Text '30 分钟|30 min'}" Tag="30" />
                        <ComboBoxItem Content="{l:Text '1 小时|1 hour'}" Tag="60" />
                    </ComboBox>
                    <Button Content="{l:Text '稍后提醒|Snooze'}" Margin="8,0,0,0" Click="Snooze_Click" />
                    <Button Content="{l:Text '重播|Replay'}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Replay_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>

</Window>

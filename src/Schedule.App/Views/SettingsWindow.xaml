<Window x:Class="Schedule.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="760" Height="700"
        MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}">
            <!-- ================= 提醒 ================= -->
            <TabItem Header="提醒">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <TextBlock Text="新建日程的默认值" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="DefaultRemindBox" Width="80" />
                            <TextBlock Text="分钟前提醒" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                        </StackPanel>
                        <CheckBox x:Name="DefaultReminderCheck" Content="新建日程时默认启用提醒" Margin="0,10,0,0" />

                        <TextBlock Text="提醒弹窗" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock Text="稍后提醒默认" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                <TextBox x:Name="SnoozeBox" Width="60" Margin="8,0,0,0" />
                                <TextBlock Text="分钟" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="自动关闭" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                <TextBox x:Name="AutoCloseBox" Width="60" Margin="8,0,0,0" />
                                <TextBlock Text="秒（0 = 不自动关闭）" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="AlwaysOnTopCheck" Content="提醒弹窗始终置顶显示" Margin="0,10,0,0" />

                        <TextBlock Text="提醒弹窗显示位置" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ReminderPositionBox" SelectionChanged="ReminderPosition_Changed">
                                <ComboBoxItem Content="右下角（默认）" />
                                <ComboBoxItem Content="左下角" />
                                <ComboBoxItem Content="右上角" />
                                <ComboBoxItem Content="左上角" />
                                <ComboBoxItem Content="屏幕中央" />
                                <ComboBoxItem Content="自定义坐标" />
                            </ComboBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                <TextBlock Text="X" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                <TextBox x:Name="ReminderPositionXBox" Width="72" Margin="6,0,0,0" TextChanged="ReminderPositionInput_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                                <TextBlock Text="Y" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                <TextBox x:Name="ReminderPositionYBox" Width="72" Margin="6,0,0,0" TextChanged="ReminderPositionInput_Changed" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="试一次位置" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Right" Click="PreviewPosition_Click" ToolTip="弹出一个预览窗，拖动它即可直接调整并记住位置" />
                        </Grid>
                        <TextBlock x:Name="ReminderPositionHint" Style="{StaticResource FieldHint}" />
                        <CheckBox x:Name="ReminderRememberPositionCheck" Content="拖动提醒弹窗后自动记住位置" Margin="0,8,0,0" />
                        <CheckBox x:Name="ReminderFollowCursorCheck" Content="弹窗出现在鼠标所在的显示器（多屏时）" Margin="0,8,0,0" />

                        <TextBlock Text="提示音" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <CheckBox x:Name="SoundEnabledCheck" Content="提醒时播放提示音" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SoundFileBox" ToolTip="留空使用系统默认提示音" />
                            <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0" Click="BrowseSound_Click" />
                            <Button Grid.Column="2" Content="试听" Margin="8,0,0,0" Click="TestSound_Click" />
                            <Button Grid.Column="3" Content="清除" Margin="8,0,0,0" Click="ClearSound_Click" />
                        </Grid>
                        <CheckBox x:Name="SoundBeforeSpeechCheck" Content="先播放提示音，再朗读语音" Margin="0,10,0,0" />

                        <TextBlock Text="数据与导入" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="主窗口默认展示" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="LookAheadBox" Width="70" Margin="8,0,0,0" />
                            <TextBlock Text="天内的日程" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="导入后默认分类" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="CsvCategoryBox" Width="140" Margin="8,0,0,0" />
                            <TextBlock Text="保留备份份数" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="BackupBox" Width="60" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 语音 ================= -->
            <TabItem Header="语音播报">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <CheckBox x:Name="SpeechEnabledCheck" Content="启用语音播报（到点自动朗读）" />
                        <TextBlock x:Name="VoiceEngineText" Style="{StaticResource FieldHint}" Margin="2,8,0,0" />

                        <TextBlock Text="音色" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="刷新" Margin="8,0,0,0" Click="RefreshVoices_Click" />
                            <ComboBox x:Name="VoiceBox" DisplayMemberPath="Text" />
                        </DockPanel>

                        <TextBlock Text="语速与音量" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="语速" VerticalAlignment="Center" Width="36" Foreground="{DynamicResource Brush.Subtle}" />
                            <Slider x:Name="RateSlider" Grid.Column="1" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="RateText" Grid.Column="2" Width="60" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量" VerticalAlignment="Center" Width="36" Foreground="{DynamicResource Brush.Subtle}" />
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="VolumeText" Grid.Column="2" Width="60" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Text="播报模板" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <TextBox x:Name="TemplateBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="占位符：{title} 标题、{time} 开始时间、{date} 日期、{weekday} 星期、{category} 分类、{notes} 备注、{priority} 优先级、{countdown} 倒计时、{status} 状态" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="标题" Tag="{}{title}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="时间" Tag="{}{time}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="日期" Tag="{}{date}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="星期" Tag="{}{weekday}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="分类" Tag="{}{category}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="备注" Tag="{}{notes}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="优先级" Tag="{}{priority}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="倒计时" Tag="{}{countdown}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="状态" Tag="{}{status}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                        </WrapPanel>

                        <TextBlock Text="按档位的全局默认文案（日程自身没有文案时生效）"
                                   Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <ItemsControl x:Name="GlobalOffsetVoiceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="12" />
                                            <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{DynamicResource Brush.Subtle}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="例如：还有 30 分钟、{title} 即将开始；留空表示使用下面的全局模板" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="优先级：日程的档位文案 &gt; 日程通用文案 &gt; 这里的档位文案 &gt; 上面的全局模板。都支持 {title} {time} {countdown} {offset} 等占位符。" />

                        <Border Background="{DynamicResource Brush.Hint}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="试听效果" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="13" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="试听（使用上面的模板与音色）" Style="{StaticResource PrimaryButton}" Click="TestVoice_Click" />
                            <Button Content="停止播报" Margin="8,0,0,0" Click="StopVoice_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 外观与默认值 ================= -->
            <TabItem Header="外观与默认值">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <TextBlock Text="主题" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ThemeBox" SelectionChanged="Theme_Changed">
                                <ComboBoxItem Content="浅色主题" />
                                <ComboBoxItem Content="夜间主题" />
                                <ComboBoxItem Content="跟随系统" />
                            </ComboBox>
                            <TextBlock x:Name="ThemeHintText" Grid.Column="1" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" />
                        </Grid>
                        <CheckBox x:Name="AutoRestartThemeCheck" Margin="0,10,0,0"
                                  Content="切换主题后自动重启软件（保证所有界面立即生效）"
                                  ToolTip="关闭后主题依然是即时生效的，只是少数已经算好的颜色要等下次启动才完全一致" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="立即重启软件" Click="Restart_Click"
                                    ToolTip="先保存设置再重启；数据与提醒计划不受影响" />
                            <TextBlock Text="设置会先保存，重启约 2 秒。" VerticalAlignment="Center"
                                       Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" />
                        </StackPanel>

                        <TextBlock Text="视图" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="启动默认视图" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <ComboBox x:Name="DefaultViewBox">
                                    <ComboBoxItem Content="列表" />
                                    <ComboBoxItem Content="周视图" />
                                    <ComboBoxItem Content="月视图" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="周视图每小时高度" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="HourHeightBox" ToolTip="像素，建议 44 - 90" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="月视图每格条数" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="MonthCapacityBox" ToolTip="1 - 8" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="默认提醒档位（分钟）" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="DefaultOffsetsBox" ToolTip="例如 30,10,0 表示提前 30 分钟、10 分钟与准点各提醒一次" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="WeekStartCheck" Content="一周从周一开始（否则从周日开始）" Margin="0,14,0,0" />

                        <TextBlock Text="分类配色（点击色块切换颜色，「自动」表示按分类名散列取色）"
                                   Style="{StaticResource SectionTitle}" Margin="2,20,0,6" />
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CategoryColorList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="自动" Style="{StaticResource GhostButton}"
                                                    Margin="6,0,0,0" Click="CategoryColorReset_Click" />
                                            <Button DockPanel.Dock="Right" Click="CategoryColorCycle_Click" Padding="3"
                                                    BorderThickness="0" Background="Transparent" Cursor="Hand" ToolTip="点击切换颜色">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Brush}"
                                                        BorderBrush="{DynamicResource Brush.SwatchRing}" BorderThickness="1" />
                                            </Button>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       FontSize="11" Foreground="{DynamicResource Brush.Subtle}" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="日程自带的颜色优先于分类配色；列表与周 / 月视图都会用该颜色区分事件。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 常规 ================= -->
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="MinimizeToTrayCheck" Content="最小化时隐藏到系统托盘" />
                        <CheckBox x:Name="CloseToTrayCheck" Content="点击关闭按钮时最小化到托盘（而不是退出）" Margin="0,8,0,0" />
                        <TextBlock Text="桌面集成" Style="{StaticResource SectionTitle}" Margin="2,20,0,6" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动" />
                        <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                            <TextBlock Text="启动参数" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="StartupArgumentsBox" Width="150" Margin="8,0,0,0"
                                     ToolTip="默认 --minimized；需要开机就提供接口可再写 --serve" />
                            <CheckBox x:Name="StartMinimizedCheck" Content="启动后最小化到托盘" Margin="16,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="AutostartStatusText" Style="{StaticResource FieldHint}" Margin="22,4,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="创建桌面快捷方式" Click="DesktopShortcut_Click" />
                            <Button Content="删除" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DeleteDesktopShortcut_Click" />
                            <Button Content="创建开始菜单快捷方式" Margin="18,0,0,0" Click="StartMenuShortcut_Click" />
                            <Button Content="删除" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DeleteStartMenuShortcut_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ShortcutStatusText" Style="{StaticResource FieldHint}" />
                        <CheckBox x:Name="ShowCompletedCheck" Content="主界面显示已完成 / 已取消的日程" Margin="0,8,0,0" />

                        <TextBlock Text="数据位置" Style="{StaticResource SectionTitle}" Margin="2,20,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="打开目录" Margin="8,0,0,0" Click="OpenDataDir_Click" />
                            <TextBox x:Name="DataDirBox" IsReadOnly="True" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="日程保存在 schedules.json，设置保存在 settings.json，每次保存都会在 backups 目录留下备份。把 portable.txt 放到程序目录即可切换为便携模式（数据存放到程序目录下的 data 文件夹）。" />

                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" Margin="2,20,0,6" />
                        <TextBlock x:Name="AboutText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Subtle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= AI 助手 ================= -->
            <TabItem Header="AI 助手">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <TextBlock Text="模型服务（本机 Ollama，或任意联网的 OpenAI 兼容服务）" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="服务预设" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiProviderBox" Grid.Column="1" SelectionChanged="AiProvider_Changed"
                                      ToolTip="选一个预设会自动填好地址、模型与鉴权方式，也可以选「自定义」自己填" />
                        </Grid>
                        <TextBlock x:Name="AiProviderHint" Style="{StaticResource FieldHint}" MaxWidth="620" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="服务地址" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="AiBaseUrlBox" Grid.Column="1"
                                     ToolTip="OpenAI 兼容根地址。Ollama：http://127.0.0.1:11434　LM Studio：http://127.0.0.1:1234/v1" />
                            <Button x:Name="TestAiButton" Grid.Column="2" Content="测试连接" Margin="8,0,0,0" Click="TestAi_Click" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="接口协议" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiApiModeBox" Grid.Column="1">
                                <ComboBoxItem Content="自动判断（推荐）" />
                                <ComboBoxItem Content="OpenAI 兼容 /v1/chat/completions" />
                                <ComboBoxItem Content="Ollama 原生 /api/chat（能关掉思考，更快）" />
                            </ComboBox>
                            <Button x:Name="FetchAiModelsButton" Grid.Column="2" Content="获取模型列表" Margin="8,0,0,0" Click="FetchAiModels_Click" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模型" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiModelBox" Grid.Column="1" IsEditable="True"
                                      ToolTip="例如 qwen3:8b。点右边「获取模型列表」可自动填。" />
                            <TextBlock Grid.Column="2" Text="接口密钥" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="AiApiKeyBox" Grid.Column="3"
                                     ToolTip="云端服务填在这里；也可以写 env:OPENAI_API_KEY 从环境变量读取（密钥就不落盘）" />
                        </Grid>
                        <TextBlock x:Name="AiKeyHint" Style="{StaticResource FieldHint}" MaxWidth="620" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="鉴权方式" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiAuthModeBox" Grid.Column="1">
                                <ComboBoxItem Content="Bearer（OpenAI / DeepSeek / 通义 等）" />
                                <ComboBoxItem Content="api-key 头（Azure OpenAI）" />
                                <ComboBoxItem Content="不带鉴权（本地服务）" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="推理强度参数" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiReasoningBox" Grid.Column="3"
                                      ToolTip="reasoning_effort：本地一定发；云端只在模型是推理模型时才发，避免不认识的字段被 400">
                                <ComboBoxItem Content="自动（推荐）" />
                                <ComboBoxItem Content="总是发送" />
                                <ComboBoxItem Content="从不发送" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="网络代理" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="AiProxyBox" Grid.Column="1"
                                     ToolTip="留空表示跟随系统代理；公司网络 / 需要代理才能访问云端时可填 http://127.0.0.1:7890" />
                            <CheckBox x:Name="AiSystemProxyCheck" Grid.Column="2" Margin="10,0,0,0" Content="使用系统代理" />
                        </Grid>

                        <TextBlock x:Name="AiStatusText" Style="{StaticResource FieldHint}" MaxWidth="620" />
                        <TextBlock x:Name="AiCloudNotice" Style="{StaticResource FieldHint}" MaxWidth="620" />

                        <TextBlock Text="生成参数" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="温度（0 ~ 2）" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="AiTemperatureBox" ToolTip="工具调用建议 0 ~ 0.3，越小越稳" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="超时（秒）" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="AiTimeoutBox" ToolTip="本地大模型首次加载较慢，可调大" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="上下文条数" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="AiHistoryBox" ToolTip="最多携带多少条历史消息" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="最大输出 token" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="AiMaxTokensBox" ToolTip="0 = 交给服务端默认" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="思考等级" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiThinkingBox" Grid.Column="1" ToolTip="本地小模型基本不需要思考；等级越低越快、越省上下文">
                                <ComboBoxItem Content="最低：完全不思考（默认，推荐）" />
                                <ComboBoxItem Content="低：少量思考" />
                                <ComboBoxItem Content="中：默认思考" />
                                <ComboBoxItem Content="高：尽量多思考" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHint}" MaxWidth="620"
                                   Text="默认最低档（关闭思考）。实测 qwen3:8b：关闭＝6~10 秒且没有思维链；选「低」仍会思考 500~700 字、要 40~50 秒。" />
                        <CheckBox x:Name="AiShowToolDetailsCheck" Margin="0,8,0,0"
                                  Content="在对话里显示工具调用详情（能看到 AI 具体做了什么）" />
                        <CheckBox x:Name="AiLogActionsCheck" Margin="0,8,0,0"
                                  Content="把 AI 的改动写入日志，便于回溯" />

                        <TextBlock Text="自定义系统提示（留空使用内置）" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <TextBox x:Name="AiSystemPromptBox" AcceptsReturn="True" Height="76" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="内置提示已包含：必须调用工具、删除前确认、时间用 24 小时制等规则" />

                        <Border Background="{DynamicResource Brush.Hint}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="怎么让对话功能跑起来" Style="{StaticResource SectionTitle}" />
                                <TextBlock TextWrapping="Wrap" MaxWidth="600" FontSize="12" Foreground="{DynamicResource Brush.Subtle}"
                                           Text="本机用法（推荐，数据不出本机）：&#10;1) 安装 Ollama（ollama.com）并保持它在后台运行；&#10;2) 命令行执行：ollama pull qwen3:8b（约 5 GB）；&#10;3) 回到这里点「测试连接」，成功后即可用主界面的「AI 对话」开聊。&#10;&#10;联网用法：在「服务预设」里选 DeepSeek / OpenAI / 通义千问 / 智谱 / Kimi / OpenRouter 等，填上接口密钥再点「测试连接」。&#10;公司网络或需要代理时，在「网络代理」里填代理地址。&#10;Azure OpenAI 这类完整端点地址可以直接整条粘贴（含 ?api-version=），鉴权方式选「api-key 头」。&#10;若服务端不认 reasoning_effort 从而报错，把「推理强度参数」调成「从不发送」。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="恢复默认" Click="Reset_Click" Margin="0,0,8,0" />
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.Subtle}" />
        </DockPanel>
    </Grid>
</Window>

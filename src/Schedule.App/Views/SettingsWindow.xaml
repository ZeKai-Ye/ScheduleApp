<Window x:Class="Schedule.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Schedule.App.Mvvm"
        Title="{l:Text '设置|Settings'}"
        Width="760" Height="700"
        MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}">
            <!-- ================= 提醒 ================= -->
            <TabItem Header="{l:Text '提醒|Reminders'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <TextBlock Text="{l:Text '新建日程的默认值|Defaults for new events'}" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="DefaultRemindBox" Width="80" />
                            <TextBlock Text="{l:Text '分钟前提醒|minutes before'}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                        </StackPanel>
                        <CheckBox x:Name="DefaultReminderCheck" Content="{l:Text '新建日程时默认启用提醒|Enable reminders by default for new events'}" Margin="0,10,0,0" />

                        <TextBlock Text="{l:Text '提醒弹窗|Reminder window'}" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock Text="{l:Text '稍后提醒默认|Default snooze'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                <TextBox x:Name="SnoozeBox" Width="60" Margin="8,0,0,0" />
                                <TextBlock Text="{l:Text '分钟|minutes'}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{l:Text '自动关闭|Auto close'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                <TextBox x:Name="AutoCloseBox" Width="60" Margin="8,0,0,0" />
                                <TextBlock Text="{l:Text '秒（0 = 不自动关闭）|seconds (0 = never auto close)'}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="AlwaysOnTopCheck" Content="{l:Text '提醒弹窗始终置顶显示|Keep the reminder window always on top'}" Margin="0,10,0,0" />

                        <TextBlock Text="{l:Text '提醒弹窗显示位置|Reminder window position'}" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ReminderPositionBox" SelectionChanged="ReminderPosition_Changed">
                                <ComboBoxItem Content="{l:Text '右下角（默认）|Bottom right (default)'}" />
                                <ComboBoxItem Content="{l:Text '左下角|Bottom left'}" />
                                <ComboBoxItem Content="{l:Text '右上角|Top right'}" />
                                <ComboBoxItem Content="{l:Text '左上角|Top left'}" />
                                <ComboBoxItem Content="{l:Text '屏幕中央|Screen center'}" />
                                <ComboBoxItem Content="{l:Text '自定义坐标|Custom coordinates'}" />
                            </ComboBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                <TextBlock Text="X" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                <TextBox x:Name="ReminderPositionXBox" Width="72" Margin="6,0,0,0" TextChanged="ReminderPositionInput_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                                <TextBlock Text="Y" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                                <TextBox x:Name="ReminderPositionYBox" Width="72" Margin="6,0,0,0" TextChanged="ReminderPositionInput_Changed" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="{l:Text '试一次位置|Preview position'}" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Right" Click="PreviewPosition_Click" ToolTip="{l:Text '弹出一个预览窗，拖动它即可直接调整并记住位置|Opens a preview window; drag it to adjust and remember the position'}" />
                        </Grid>
                        <TextBlock x:Name="ReminderPositionHint" Style="{StaticResource FieldHint}" />
                        <CheckBox x:Name="ReminderRememberPositionCheck" Content="{l:Text '拖动提醒弹窗后自动记住位置|Remember the position after dragging the reminder window'}" Margin="0,8,0,0" />
                        <CheckBox x:Name="ReminderFollowCursorCheck" Content="{l:Text '弹窗出现在鼠标所在的显示器（多屏时）|Show on the monitor where the mouse is (multi-monitor)'}" Margin="0,8,0,0" />

                        <TextBlock Text="{l:Text '提示音|Sound'}" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <CheckBox x:Name="SoundEnabledCheck" Content="{l:Text '提醒时播放提示音|Play a sound when a reminder fires'}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SoundFileBox" ToolTip="{l:Text '留空使用系统默认提示音|Leave empty to use the system default sound'}" />
                            <Button Grid.Column="1" Content="{l:Text '浏览|Browse'}" Margin="8,0,0,0" Click="BrowseSound_Click" />
                            <Button Grid.Column="2" Content="{l:Text '试听|Preview'}" Margin="8,0,0,0" Click="TestSound_Click" />
                            <Button Grid.Column="3" Content="{l:Text '清除|Clear'}" Margin="8,0,0,0" Click="ClearSound_Click" />
                        </Grid>
                        <CheckBox x:Name="SoundBeforeSpeechCheck" Content="{l:Text '先播放提示音，再朗读语音|Play the sound first, then speak'}" Margin="0,10,0,0" />

                        <TextBlock Text="{l:Text '数据与导入|Data and import'}" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Text '主窗口默认展示|Default range on main window'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="LookAheadBox" Width="70" Margin="8,0,0,0" />
                            <TextBlock Text="{l:Text '天内的日程|days of events'}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{l:Text '导入后默认分类|Default category after import'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="CsvCategoryBox" Width="140" Margin="8,0,0,0" />
                            <TextBlock Text="{l:Text '保留备份份数|Backups to keep'}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="BackupBox" Width="60" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 语音 ================= -->
            <TabItem Header="{l:Text '语音播报|Voice'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <CheckBox x:Name="SpeechEnabledCheck" Content="{l:Text '启用语音播报（到点自动朗读）|Enable voice announcement (speaks when a reminder fires)'}" />
                        <TextBlock x:Name="VoiceEngineText" Style="{StaticResource FieldHint}" Margin="2,8,0,0" />

                        <TextBlock Text="{l:Text '音色|Voice'}" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Text '刷新|Refresh'}" Margin="8,0,0,0" Click="RefreshVoices_Click" />
                            <ComboBox x:Name="VoiceBox" DisplayMemberPath="Text" />
                        </DockPanel>

                        <TextBlock Text="{l:Text '语速与音量|Rate and volume'}" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text '语速|Rate'}" VerticalAlignment="Center" Width="36" Foreground="{DynamicResource Brush.Subtle}" />
                            <Slider x:Name="RateSlider" Grid.Column="1" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="RateText" Grid.Column="2" Width="60" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text '音量|Volume'}" VerticalAlignment="Center" Width="36" Foreground="{DynamicResource Brush.Subtle}" />
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="VolumeText" Grid.Column="2" Width="60" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Text="{l:Text '播报模板|Voice template'}" Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <TextBox x:Name="TemplateBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="{l:Text '占位符：{title} 标题、{time} 开始时间、{date} 日期、{weekday} 星期、{category} 分类、{notes} 备注、{priority} 优先级、{countdown} 倒计时、{status} 状态|Placeholders: {title} title, {time} start time, {date} date, {weekday} weekday, {category} category, {notes} notes, {priority} priority, {countdown} countdown, {status} status'}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{l:Text '标题|Title'}" Tag="{}{title}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="{l:Text '时间|Time'}" Tag="{}{time}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="{l:Text '日期|Date'}" Tag="{}{date}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="{l:Text '星期|Weekday'}" Tag="{}{weekday}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="{l:Text '分类|Category'}" Tag="{}{category}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="{l:Text '备注|Notes'}" Tag="{}{notes}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="{l:Text '优先级|Priority'}" Tag="{}{priority}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="{l:Text '倒计时|Countdown'}" Tag="{}{countdown}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                            <Button Content="{l:Text '状态|Status'}" Tag="{}{status}" Style="{StaticResource GhostButton}" Click="InsertToken_Click" />
                        </WrapPanel>

                        <TextBlock Text="{l:Text '按档位的全局默认文案（日程自身没有文案时生效）|Global template per offset (used when the event has no text of its own)'}"
                                   Style="{StaticResource SectionTitle}" Margin="2,16,0,6" />
                        <ItemsControl x:Name="GlobalOffsetVoiceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="12" />
                                            <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{DynamicResource Brush.Subtle}" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{l:Text '例如：还有 30 分钟、{title} 即将开始；留空表示使用下面的全局模板|For example: 30 minutes left, {title} starts soon; leave empty to use the global template below'}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="{l:Text '优先级：日程的档位文案 &gt; 日程通用文案 &gt; 这里的档位文案 &gt; 上面的全局模板。都支持 {title} {time} {countdown} {offset} 等占位符。|Priority: per-offset text on the event &gt; general text on the event &gt; per-offset text here &gt; the global template above. All support placeholders such as {title} {time} {countdown} {offset}.'}" />

                        <Border Background="{DynamicResource Brush.Hint}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:Text '试听效果|Preview'}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="13" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{l:Text '试听（使用上面的模板与音色）|Preview (uses the template and voice above)'}" Style="{StaticResource PrimaryButton}" Click="TestVoice_Click" />
                            <Button Content="{l:Text '停止播报|Stop speaking'}" Margin="8,0,0,0" Click="StopVoice_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 外观与默认值 ================= -->
            <TabItem Header="{l:Text '外观与默认值|Appearance and defaults'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <TextBlock Text="{l:Text '界面语言|Language'}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LanguageBox" SelectionChanged="Language_Changed">
                                <ComboBoxItem Content="{l:Text '跟随系统|Follow system'}" />
                                <ComboBoxItem Content="{l:Text '中文|Chinese'}" />
                                <ComboBoxItem Content="{l:Text 'English|English'}" />
                            </ComboBox>
                            <TextBlock x:Name="LanguageHintText" Grid.Column="1" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Subtle}" />
                        </Grid>

                        <TextBlock Text="{l:Text '主题|Theme'}" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ThemeBox" SelectionChanged="Theme_Changed">
                                <ComboBoxItem Content="{l:Text '浅色主题|Light theme'}" />
                                <ComboBoxItem Content="{l:Text '夜间主题|Dark theme'}" />
                                <ComboBoxItem Content="{l:Text '跟随系统|Follow system'}" />
                            </ComboBox>
                            <TextBlock x:Name="ThemeHintText" Grid.Column="1" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" />
                        </Grid>
                        <CheckBox x:Name="AutoRestartThemeCheck" Margin="0,10,0,0"
                                  Content="{l:Text '切换主题后自动重启软件（保证所有界面立即生效）|Restart automatically after changing the theme (so every view updates at once)'}"
                                  ToolTip="{l:Text '关闭后主题依然是即时生效的，只是少数已经算好的颜色要等下次启动才完全一致|The theme still applies immediately when this is off; only a few already computed colors match fully at the next start'}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{l:Text '立即重启软件|Restart now'}" Click="Restart_Click"
                                    ToolTip="{l:Text '先保存设置再重启；数据与提醒计划不受影响|Saves settings, then restarts; data and reminders are unaffected'}" />
                            <TextBlock Text="{l:Text '设置会先保存，重启约 2 秒。|Settings are saved first; the restart takes about 2 seconds.'}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" />
                        </StackPanel>

                        <TextBlock Text="{l:Text '视图|Views'}" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{l:Text '启动默认视图|Default view at startup'}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <ComboBox x:Name="DefaultViewBox">
                                    <ComboBoxItem Content="{l:Text '列表|List'}" />
                                    <ComboBoxItem Content="{l:Text '周视图|Week view'}" />
                                    <ComboBoxItem Content="{l:Text '月视图|Month view'}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="{l:Text '周视图每小时高度|Week view hour height'}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="HourHeightBox" ToolTip="{l:Text '像素，建议 44 - 90|Pixels, 44 - 90 recommended'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="{l:Text '月视图每格条数|Month view events per cell'}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="MonthCapacityBox" ToolTip="1 - 8" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{l:Text '默认提醒档位（分钟）|Default reminder offsets (minutes)'}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="DefaultOffsetsBox" ToolTip="{l:Text '例如 30,10,0 表示提前 30 分钟、10 分钟与准点各提醒一次|For example 30,10,0 reminds 30 minutes before, 10 minutes before and right on time'}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="WeekStartCheck" Content="{l:Text '一周从周一开始（否则从周日开始）|Weeks start on Monday (otherwise Sunday)'}" Margin="0,14,0,0" />

                        <TextBlock Text="{l:Text '分类配色（点击色块切换颜色，「自动」表示按分类名散列取色）|Category colors (click a swatch to change the color; Auto picks a color hashed from the category name)'}"
                                   Style="{StaticResource SectionTitle}" Margin="2,20,0,6" />
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CategoryColorList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="{l:Text '自动|Auto'}" Style="{StaticResource GhostButton}"
                                                    Margin="6,0,0,0" Click="CategoryColorReset_Click" />
                                            <Button DockPanel.Dock="Right" Click="CategoryColorCycle_Click" Padding="3"
                                                    BorderThickness="0" Background="Transparent" Cursor="Hand" ToolTip="{l:Text '点击切换颜色|Click to change the color'}">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Brush}"
                                                        BorderBrush="{DynamicResource Brush.SwatchRing}" BorderThickness="1" />
                                            </Button>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       FontSize="11" Foreground="{DynamicResource Brush.Subtle}" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="{l:Text '日程自带的颜色优先于分类配色；列表与周 / 月视图都会用该颜色区分事件。|A color set on the event overrides the category color; the list, week and month views all use it to tell events apart.'}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 常规 ================= -->
            <TabItem Header="{l:Text '常规|General'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <TextBlock Text="{l:Text '窗口行为|Window behavior'}" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="MinimizeToTrayCheck" Content="{l:Text '最小化时隐藏到系统托盘|Hide to the system tray when minimized'}" />
                        <CheckBox x:Name="CloseToTrayCheck" Content="{l:Text '点击关闭按钮时最小化到托盘（而不是退出）|Minimize to the tray instead of exiting when closing'}" Margin="0,8,0,0" />
                        <TextBlock Text="{l:Text '桌面集成|Desktop integration'}" Style="{StaticResource SectionTitle}" Margin="2,20,0,6" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="{l:Text '开机自动启动|Start with Windows'}" />
                        <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                            <TextBlock Text="{l:Text '启动参数|Startup arguments'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="StartupArgumentsBox" Width="150" Margin="8,0,0,0"
                                     ToolTip="{l:Text '默认 --minimized；需要开机就提供接口可再写 --serve|--minimized by default; add --serve to expose the API right after boot'}" />
                            <CheckBox x:Name="StartMinimizedCheck" Content="{l:Text '启动后最小化到托盘|Start minimized to the tray'}" Margin="16,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="AutostartStatusText" Style="{StaticResource FieldHint}" Margin="22,4,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{l:Text '创建桌面快捷方式|Create desktop shortcut'}" Click="DesktopShortcut_Click" />
                            <Button Content="{l:Text '删除|Delete'}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DeleteDesktopShortcut_Click" />
                            <Button Content="{l:Text '创建开始菜单快捷方式|Create Start menu shortcut'}" Margin="18,0,0,0" Click="StartMenuShortcut_Click" />
                            <Button Content="{l:Text '删除|Delete'}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DeleteStartMenuShortcut_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ShortcutStatusText" Style="{StaticResource FieldHint}" />
                        <CheckBox x:Name="ShowCompletedCheck" Content="{l:Text '主界面显示已完成 / 已取消的日程|Show completed / canceled events in the main list'}" Margin="0,8,0,0" />

                        <TextBlock Text="{l:Text '数据位置|Data location'}" Style="{StaticResource SectionTitle}" Margin="2,20,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Text '打开目录|Open folder'}" Margin="8,0,0,0" Click="OpenDataDir_Click" />
                            <TextBox x:Name="DataDirBox" IsReadOnly="True" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="{l:Text '日程保存在 schedules.json，设置保存在 settings.json，每次保存都会在 backups 目录留下备份。把 portable.txt 放到程序目录即可切换为便携模式（数据存放到程序目录下的 data 文件夹）。|Events are stored in schedules.json and settings in settings.json; every save leaves a backup in the backups folder. Drop portable.txt next to the executable to switch to portable mode (data goes to the data folder there).'}" />

                        <TextBlock Text="{l:Text '关于|About'}" Style="{StaticResource SectionTitle}" Margin="2,20,0,6" />
                        <TextBlock x:Name="AboutText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Subtle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= AI 助手 ================= -->
            <TabItem Header="{l:Text 'AI 助手|AI assistant'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Padding="18,16" MinWidth="580">
                    <StackPanel>
                        <TextBlock Text="{l:Text '模型服务（本机 Ollama，或任意联网的 OpenAI 兼容服务）|Model service (local Ollama, or any online OpenAI-compatible service)'}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text '服务预设|Presets'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiProviderBox" Grid.Column="1" SelectionChanged="AiProvider_Changed"
                                      ToolTip="{l:Text '选一个预设会自动填好地址、模型与鉴权方式，也可以选「自定义」自己填|Pick a preset to fill in the URL, model and auth mode, or choose Custom and fill them in yourself'}" />
                        </Grid>
                        <TextBlock x:Name="AiProviderHint" Style="{StaticResource FieldHint}" MaxWidth="620" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text '服务地址|Service URL'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="AiBaseUrlBox" Grid.Column="1"
                                     ToolTip="{l:Text 'OpenAI 兼容根地址。Ollama：http://127.0.0.1:11434　LM Studio：http://127.0.0.1:1234/v1|OpenAI-compatible base URL. Ollama: http://127.0.0.1:11434  LM Studio: http://127.0.0.1:1234/v1'}" />
                            <Button x:Name="TestAiButton" Grid.Column="2" Content="{l:Text '测试连接|Test connection'}" Margin="8,0,0,0" Click="TestAi_Click" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text '接口协议|API protocol'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiApiModeBox" Grid.Column="1">
                                <ComboBoxItem Content="{l:Text '自动判断（推荐）|Auto detect (recommended)'}" />
                                <ComboBoxItem Content="{l:Text 'OpenAI 兼容 /v1/chat/completions|OpenAI-compatible /v1/chat/completions'}" />
                                <ComboBoxItem Content="{l:Text 'Ollama 原生 /api/chat（能关掉思考，更快）|Ollama native /api/chat (can turn thinking off; faster)'}" />
                            </ComboBox>
                            <Button x:Name="FetchAiModelsButton" Grid.Column="2" Content="{l:Text '获取模型列表|Fetch models'}" Margin="8,0,0,0" Click="FetchAiModels_Click" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text '模型|Model'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiModelBox" Grid.Column="1" IsEditable="True"
                                      ToolTip="{l:Text '例如 qwen3:8b。点右边「获取模型列表」可自动填。|For example qwen3:8b. Click Fetch models on the right to fill it in automatically.'}" />
                            <TextBlock Grid.Column="2" Text="{l:Text '接口密钥|API key'}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="AiApiKeyBox" Grid.Column="3"
                                     ToolTip="{l:Text '云端服务填在这里；也可以写 env:OPENAI_API_KEY 从环境变量读取（密钥就不落盘）|Fill this in for cloud services; you can also write env:OPENAI_API_KEY to read it from an environment variable (the key is then never stored on disk)'}" />
                        </Grid>
                        <TextBlock x:Name="AiKeyHint" Style="{StaticResource FieldHint}" MaxWidth="620" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text '鉴权方式|Auth mode'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiAuthModeBox" Grid.Column="1">
                                <ComboBoxItem Content="{l:Text 'Bearer（OpenAI / DeepSeek / 通义 等）|Bearer (OpenAI / DeepSeek / Qwen, etc.)'}" />
                                <ComboBoxItem Content="{l:Text 'api-key 头（Azure OpenAI）|api-key header (Azure OpenAI)'}" />
                                <ComboBoxItem Content="{l:Text '不带鉴权（本地服务）|No auth (local services)'}" />
                            </ComboBox>
                        <TextBlock Grid.Column="2" Text="{l:Text '推理强度参数|Reasoning'}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiReasoningBox" Grid.Column="3"
                                      ToolTip="{l:Text 'reasoning_effort：本地一定发；云端只在模型是推理模型时才发，避免不认识的字段被 400|reasoning_effort: always sent to local services; for cloud services it is only sent when the model is a reasoning model, so unknown fields do not cause a 400'}">
                                <ComboBoxItem Content="{l:Text '自动（推荐）|Auto (recommended)'}" />
                                <ComboBoxItem Content="{l:Text '总是发送|Always send'}" />
                                <ComboBoxItem Content="{l:Text '从不发送|Never send'}" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text '网络代理|Proxy'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <TextBox x:Name="AiProxyBox" Grid.Column="1"
                                     ToolTip="{l:Text '留空表示跟随系统代理；公司网络 / 需要代理才能访问云端时可填 http://127.0.0.1:7890|Leave empty to follow the system proxy; if your network needs a proxy to reach cloud services, enter something like http://127.0.0.1:7890'}" />
                            <CheckBox x:Name="AiSystemProxyCheck" Grid.Column="2" Margin="10,0,0,0" Content="{l:Text '使用系统代理|Use the system proxy'}" />
                        </Grid>

                        <TextBlock x:Name="AiStatusText" Style="{StaticResource FieldHint}" MaxWidth="620" />
                        <TextBlock x:Name="AiCloudNotice" Style="{StaticResource FieldHint}" MaxWidth="620" />

                        <TextBlock Text="{l:Text '生成参数|Generation'}" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{l:Text '温度（0 ~ 2）|Temperature (0–2)'}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="AiTemperatureBox" ToolTip="{l:Text '工具调用建议 0 ~ 0.3，越小越稳|For tool calling 0 - 0.3 is recommended; lower is more stable'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="{l:Text '超时（秒）|Timeout (s)'}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="AiTimeoutBox" ToolTip="{l:Text '本地大模型首次加载较慢，可调大|Local models load slowly the first time; increase this if needed'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="{l:Text '上下文条数|History messages'}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="AiHistoryBox" ToolTip="{l:Text '最多携带多少条历史消息|How many history messages to send at most'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{l:Text '最大输出 token|Max output tokens'}" FontSize="11" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,0,3" />
                                <TextBox x:Name="AiMaxTokensBox" ToolTip="{l:Text '0 = 交给服务端默认|0 = use the server default'}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Text '思考等级|Thinking level'}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" />
                            <ComboBox x:Name="AiThinkingBox" Grid.Column="1" ToolTip="{l:Text '本地小模型基本不需要思考；等级越低越快、越省上下文|Small local models rarely need thinking; a lower level is faster and uses less context'}">
                                <ComboBoxItem Content="{l:Text '最低：完全不思考（默认，推荐）|Lowest: no thinking at all (default, recommended)'}" />
                                <ComboBoxItem Content="{l:Text '低：少量思考|Low: a little thinking'}" />
                                <ComboBoxItem Content="{l:Text '中：默认思考|Medium: normal thinking'}" />
                                <ComboBoxItem Content="{l:Text '高：尽量多思考|High: think as much as possible'}" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHint}" MaxWidth="620"
                                   Text="{l:Text '默认最低档（关闭思考）。实测 qwen3:8b：关闭＝6~10 秒且没有思维链；选「低」仍会思考 500~700 字、要 40~50 秒。|Lowest is the default (thinking off). Measured with qwen3:8b: off takes 6-10 s with no chain of thought, while Low still thinks for 500-700 characters and takes 40-50 s.'}" />
                        <CheckBox x:Name="AiShowToolDetailsCheck" Margin="0,8,0,0"
                                  Content="{l:Text '在对话里显示工具调用详情（能看到 AI 具体做了什么）|Show tool call details in the chat (so you can see what the AI actually did)'}" />
                        <CheckBox x:Name="AiLogActionsCheck" Margin="0,8,0,0"
                                  Content="{l:Text '把 AI 的改动写入日志，便于回溯|Log the AI changes so they can be traced later'}" />

                        <TextBlock Text="{l:Text '自定义系统提示（留空使用内置）|Custom system prompt (leave empty to use the built-in one)'}" Style="{StaticResource SectionTitle}" Margin="2,18,0,6" />
                        <TextBox x:Name="AiSystemPromptBox" AcceptsReturn="True" Height="76" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="{l:Text '内置提示已包含：必须调用工具、删除前确认、时间用 24 小时制等规则|The built-in prompt already covers: always use tools, confirm before deleting, 24-hour times and similar rules'}" />

                        <Border Background="{DynamicResource Brush.Hint}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:Text '怎么让对话功能跑起来|How to get the chat working'}" Style="{StaticResource SectionTitle}" />
                                <TextBlock TextWrapping="Wrap" MaxWidth="600" FontSize="12" Foreground="{DynamicResource Brush.Subtle}"
                                           Text="{l:Text '本机用法（推荐，数据不出本机）：&#10;1) 安装 Ollama（ollama.com）并保持它在后台运行；&#10;2) 命令行执行：ollama pull qwen3:8b（约 5 GB）；&#10;3) 回到这里点「测试连接」，成功后即可用主界面的「AI 对话」开聊。&#10;&#10;联网用法：在「服务预设」里选 DeepSeek / OpenAI / 通义千问 / 智谱 / Kimi / OpenRouter 等，填上接口密钥再点「测试连接」。&#10;公司网络或需要代理时，在「网络代理」里填代理地址。&#10;Azure OpenAI 这类完整端点地址可以直接整条粘贴（含 ?api-version=），鉴权方式选「api-key 头」。&#10;若服务端不认 reasoning_effort 从而报错，把「推理强度参数」调成「从不发送」。|Local setup (recommended; data never leaves this machine):&#10;1) Install Ollama (ollama.com) and keep it running in the background;&#10;2) In a terminal run: ollama pull qwen3:8b (about 5 GB);&#10;3) Come back here and click Test connection; once it works, open AI chat on the main window and start talking.&#10;&#10;Online setup: pick DeepSeek / OpenAI / Qwen / Zhipu / Kimi / OpenRouter etc. under Presets, enter the API key, then click Test connection.&#10;On a corporate network or behind a proxy, enter the proxy address under Proxy.&#10;Full endpoint URLs such as Azure OpenAI can be pasted as-is (including ?api-version=); set Auth mode to api-key header.&#10;If the server rejects reasoning_effort with an error, set Reasoning effort to Never send.'}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:Text '恢复默认|Restore defaults'}" Click="Reset_Click" Margin="0,0,8,0" />
                <Button Content="{l:Text '取消|Cancel'}" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="{l:Text '保存|Save'}" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.Subtle}" />
        </DockPanel>
    </Grid>
</Window>

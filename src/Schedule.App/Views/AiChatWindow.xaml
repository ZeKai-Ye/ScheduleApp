<Window x:Class="Schedule.App.Views.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 对话"
        Width="840" Height="740"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：模型选择 -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshModelsButton" Content="刷新模型" Click="RefreshModels_Click" Margin="0,0,8,0"
                            ToolTip="从模型服务读取可用模型列表" />
                    <Button Content="AI 设置…" Click="OpenSettings_Click" Margin="0,0,8,0" />
                    <Button Content="清空对话" Style="{StaticResource GhostButton}" Click="Clear_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="模型" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Subtle}" Margin="0,0,6,0" />
                    <ComboBox x:Name="ModelBox" IsEditable="True" Width="230" SelectionChanged="Model_Changed"
                              ToolTip="可以直接输入模型名，例如 qwen3:8b" />
                    <Border x:Name="CloudBadge" Margin="10,0,0,0" Padding="8,2" CornerRadius="9" VerticalAlignment="Center"
                            BorderThickness="1">
                        <TextBlock x:Name="CloudBadgeText" FontSize="11" />
                    </Border>
                    <TextBlock x:Name="EndpointText" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                               Foreground="{DynamicResource Brush.Subtle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 消息列表 -->
        <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="14,12">
            <ItemsControl x:Name="MessageList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,9"
                                    MaxWidth="640" HorizontalAlignment="{Binding Alignment}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.Subtle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding HeaderBrush}" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,5,0,0" />

                                    <Expander Header="思考过程" Visibility="{Binding ReasoningVisibility}" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource Brush.Subtle}" MaxHeight="220" />
                                    </Expander>

                                    <Expander Header="工具调用详情" Visibility="{Binding DetailsVisibility}" Margin="0,6,0,0">
                                        <TextBox Text="{Binding Details}" IsReadOnly="True" TextWrapping="Wrap"
                                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                                 AcceptsReturn="True" MaxHeight="180" VerticalScrollBarVisibility="Auto" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 输入区 -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="62" MaxHeight="150" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="Input_KeyDown"
                         ToolTip="回车发送，Shift + 回车换行" />

                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="StopButton" Content="停止" Click="Stop_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                        <Button x:Name="SendButton" Content="发送" Style="{StaticResource PrimaryButton}" Click="Send_Click" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Subtle}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

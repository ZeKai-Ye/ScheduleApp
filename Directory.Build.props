<Project>

  <!-- 全解决方案统一编译约定：一处修改，三个项目同时生效 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 与 CHANGELOG 保持一致：发布版本号（窗口标题、日志、接口 /api/system/info 都会读它） -->
    <Version>0.9.0</Version>
    <Product>日程助手 ScheduleApp</Product>
    <Company>ScheduleApp</Company>
    <Copyright>Copyright (c) 2025</Copyright>
    <!-- 本项目仅面向 Windows 11，无需平台兼容性告警 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

</Project>
